---
import Layout from "./Layout.astro";
import config from "@/config";
import { useTranslations } from "@/i18n";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import {
  breadcrumbSchema,
  graph,
  personRef,
  personSchema,
  siteRootUrl,
  websiteRef,
} from "@/utils/structuredData";

type Props = {
  title?: string;
  articleTitle?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  tags?: string[];
  wordCount?: number;
};

const { site } = config;
const t = useTranslations(Astro.currentLocale ?? site.lang);

const {
  title,
  articleTitle,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags = [],
  wordCount,
} = Astro.props;

const articleURL = canonicalURL ?? new URL(Astro.url.pathname, Astro.site).href;
const headline = articleTitle ?? title ?? site.title;
// Google requires an image for article rich results; fall back to the site card.
const imageURL =
  ogImage ?? new URL(resolveDefaultOgImagePath(config), Astro.site).href;

const structuredData = graph(
  {
    "@type": "BlogPosting",
    "@id": `${articleURL}#article`,
    headline,
    description,
    url: articleURL,
    mainEntityOfPage: { "@type": "WebPage", "@id": articleURL },
    image: [imageURL],
    inLanguage: site.lang,
    ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
    dateModified: (modDatetime ?? pubDatetime)?.toISOString(),
    author: personRef,
    publisher: personRef,
    isPartOf: websiteRef,
    ...(tags.length > 0 && { keywords: tags.join(", ") }),
    ...(wordCount && { wordCount }),
  },
  personSchema(),
  breadcrumbSchema([
    [site.title, siteRootUrl],
    [t.nav.posts, new URL("posts/", siteRootUrl).href],
    [headline, articleURL],
  ])
);
---

<Layout
  {title}
  {description}
  {ogImage}
  canonicalURL={articleURL}
  ogType="article"
  {structuredData}
>
  <Fragment slot="head">
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }
    <meta property="article:author" content={site.author} />
    {tags.map(tag => <meta property="article:tag" content={tag} />)}
  </Fragment>

  <slot />
</Layout>
